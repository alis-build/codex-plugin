{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/load-primer.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/ensure-alis-rule.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-service-context.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|bash|shell|local_shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/record-agent-approval.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
